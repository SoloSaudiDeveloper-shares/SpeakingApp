{
  "name": "speaking-lab",
  "productName": "Speaking Lab",
  "version": "1.0.0",
  "description": "Offline English speaking practice platform for Arabic learners",
  "author": "Speaking Lab Team",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.7",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "phonemizer": "^1.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5",
    "wavefile": "^11.0.0"
  },
  "build": {
    "appId": "com.speakinglab.app",
    "productName": "Speaking Lab",
    "directories": {
      "output": "../dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SpeakingLab-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
