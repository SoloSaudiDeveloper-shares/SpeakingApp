{
  "name": "speaking-lab",
  "productName": "Speaking Lab",
  "version": "1.0.0",
  "description": "Azure-ready English speaking practice platform for Arabic learners",
  "author": "Speaking Lab Team",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prune-standalone.mjs",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.mjs",
    "db:check": "tsx scripts/db-check.ts",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "backup:data": "tsx scripts/backup-postgres.ts",
    "backup:restore-test": "tsx scripts/restore-postgres-test.ts",
    "security:secrets": "gitleaks git --redact --no-banner",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:learning-quality": "node scripts/learning-quality-check.mjs",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:live-gates": "node scripts/run-live-gates.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.33.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.7",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.31.10",
    "phonemizer": "^1.2.1",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wavefile": "^11.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "adm-zip": "0.6.0"
  }
}
